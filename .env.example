# Backend URL for DNS policy checks. The DNS service runs on the same VPS as
# the backend, so use loopback (no TLS/Nginx overhead on the hot path).
BACKEND_URL=http://127.0.0.1:3000

# Upstream DNS resolvers (comma-separated)
UPSTREAM_DNS=1.1.1.1,8.8.8.8

# DNS server port (53 requires root, use 5353 for dev)
DNS_PORT=53

# Log level: debug, info, warn, error
LOG_LEVEL=info
